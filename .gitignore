# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
# node
node_modules/
dist/
# latex build output (the compiled report PDF is kept on purpose)
report/*.aux
report/*.bbl
report/*.bcf
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
report/*.run.xml
report/*.toc
report/*.xdv
# archive downloads: large FITS stay in a local cache; small fixtures go under backend/tests/fixtures
data/cache/
*.fits
!backend/tests/fixtures/*.fits
.env
# video: Remotion dependencies and render caches (the final MP4 and the source are kept)
video/remotion/node_modules/
video/remotion/out/
video/remotion/.remotion/
*.webm
# editors, OS and scratch files
.vscode/
.idea/
*.swp
*~
.DS_Store
*.tmp
*.log
# local secrets of any kind
.env.*
*.pem
*.key
# notebooks, linters, coverage
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
# Manim render caches (final clips and stills are kept under visualizations/manim/renders and docs/media/manim)
visualizations/manim/.venv/
visualizations/manim/media/
# intermediate video frames and audio
video/**/frames/
*.wav.tmp
